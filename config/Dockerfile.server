# Dockerfile para el Servidor de Chat
# Servidor de sockets con SSL/TLS

FROM python:3.11-slim

# Metadata
LABEL maintainer="Chat-Multihilo-DChat"
LABEL description="Servidor de chat con SSL/TLS y persistencia de datos"

# Variables de entorno
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DATA_DIR=/app/data
ENV CERT_DIR=/app/certs
ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=5000

# Directorio de trabajo
WORKDIR /app

# Crear directorios necesarios
RUN mkdir -p /app/data /app/certs

# Copiar archivos de requisitos
COPY config/requirements-server.txt .

# Instalar dependencias de Python
RUN pip install --no-cache-dir -r requirements-server.txt

# Copiar código fuente
COPY src/ ./src/
COPY config/.env.example .env

# Exponer puerto del servidor
EXPOSE 5000

# Healthcheck deshabilitado - el servidor usa SSL y requiere handshake completo
# HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
#     CMD python -c "import socket; s=socket.socket(); s.settimeout(2); s.connect(('localhost', 5000)); s.close()" || exit 1

# Comando de inicio
CMD ["python", "src/server/chat_server.py"]

# Made with Bob
